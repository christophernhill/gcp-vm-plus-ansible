# Generated by generator/generate.py from config/vm.yaml — do not edit by hand.

terraform {
  required_version = ">= 1.6"
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 6.0"
    }
  }
}

provider "google" {
  project = "{{ gcp.project_id }}"
  region  = "{{ gcp.region }}"
  zone    = "{{ gcp.zone }}"
}

resource "google_compute_network" "vpc" {
  name                    = "{{ network.name }}"
  auto_create_subnetworks = {{ "false" if vm.nic_count > 1 else "true" }}
}
{% if vm.nic_count > 1 %}
# One subnet per NIC: GCP requires each interface on a unique subnet
# (they may share the VPC as long as nic0 is attached to it too).
resource "google_compute_subnetwork" "subnet" {
  count         = {{ vm.nic_count }}
  name          = "{{ network.name }}-subnet-${count.index}"
  network       = google_compute_network.vpc.self_link
  region        = "{{ gcp.region }}"
  ip_cidr_range = "10.10.${count.index}.0/24"
}
{% endif %}
# GCP VPCs deny all ingress by default; these rules are the only inbound paths.
resource "google_compute_firewall" "allow_ssh" {
  name      = "{{ network.name }}-allow-ssh"
  network   = google_compute_network.vpc.name
  direction = "INGRESS"

  allow {
    protocol = "tcp"
    ports    = ["22"]
  }

  source_ranges = [{% for cidr in network.ssh_source_ranges %}"{{ cidr }}"{{ ", " if not loop.last }}{% endfor %}]
  target_tags   = ["{{ vm.name }}"]
}
{% if open_ports.tcp or open_ports.udp %}
# Extra ports opened to the public internet via network.open_ports.
resource "google_compute_firewall" "allow_public" {
  name      = "{{ network.name }}-allow-public"
  network   = google_compute_network.vpc.name
  direction = "INGRESS"
{% for proto in ("tcp", "udp") if open_ports[proto] %}
  allow {
    protocol = "{{ proto }}"
    ports    = [{% for port in open_ports[proto] %}"{{ port }}"{{ ", " if not loop.last }}{% endfor %}]
  }
{% endfor %}
  source_ranges = ["0.0.0.0/0"]
  target_tags   = ["{{ vm.name }}"]
}
{% endif %}
resource "google_compute_instance" "vm" {
  name         = "{{ vm.name }}"
  machine_type = "{{ vm.machine_type }}"
  zone         = "{{ gcp.zone }}"
  tags         = ["{{ vm.name }}"]

  boot_disk {
    initialize_params {
      image = "{{ vm.image.project }}/{{ vm.image.family }}"
      size  = {{ vm.boot_disk_gb }}
      type  = "{{ vm.boot_disk_type }}"
    }
  }
{% if vm.nic_count > 1 %}
{%- for i in range(vm.nic_count) %}
  network_interface {
    subnetwork = google_compute_subnetwork.subnet[{{ i }}].self_link
    access_config {} # ephemeral public IP
  }
{% endfor %}
{%- else %}
  network_interface {
    network = google_compute_network.vpc.self_link
    access_config {} # ephemeral public IP
  }
{% endif %}
  metadata = {
{%- if vm.nic_count > 1 %}
    ssh-keys       = "{% for key in ssh_public_keys %}{{ vm.ssh_user }}:{{ key }}{{ '\\n' if not loop.last }}{% endfor %}"
    startup-script = <<-EOT
{{ startup_script | indent(6, true, true) }}
    EOT
{%- else %}
    ssh-keys = "{% for key in ssh_public_keys %}{{ vm.ssh_user }}:{{ key }}{{ '\\n' if not loop.last }}{% endfor %}"
{%- endif %}
  }
}
{% if vm.external_ip_count > 1 %}
# Extra external IPv4 addresses, delivered to the VM's single NIC via
# protocol forwarding. The google-guest-agent in the image installs
# local routes for them automatically, and the VPC firewall still
# applies — the same rules govern every address.
resource "google_compute_address" "extra" {
  count  = {{ vm.external_ip_count - 1 }}
  name   = "{{ vm.name }}-ip-${count.index + 2}"
  region = "{{ gcp.region }}"
}

resource "google_compute_target_instance" "vm" {
  name     = "{{ vm.name }}-target"
  zone     = "{{ gcp.zone }}"
  instance = google_compute_instance.vm.self_link
}

resource "google_compute_forwarding_rule" "extra" {
  count       = {{ vm.external_ip_count - 1 }}
  name        = "{{ vm.name }}-fwd-${count.index + 2}"
  region      = "{{ gcp.region }}"
  ip_address  = google_compute_address.extra[count.index].self_link
  ip_protocol = "L3_DEFAULT"
  all_ports   = true
  target      = google_compute_target_instance.vm.self_link
}
{% endif %}
output "public_ip" {
  value = google_compute_instance.vm.network_interface[0].access_config[0].nat_ip
}
{% if vm.external_ip_count > 1 %}
output "public_ips" {
  value = concat(
    [for nic in google_compute_instance.vm.network_interface : nic.access_config[0].nat_ip],
    google_compute_address.extra[*].address
  )
}
{% else %}
output "public_ips" {
  value = [for nic in google_compute_instance.vm.network_interface : nic.access_config[0].nat_ip]
}
{% endif %}
output "ssh_command" {
  value = "ssh {{ vm.ssh_user }}@${google_compute_instance.vm.network_interface[0].access_config[0].nat_ip}"
}
