# Generated by generator/generate.py — provider: aws — do not edit by hand.

terraform {
  required_version = ">= 1.6"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }
}

provider "aws" {
  region = "{{ aws.region }}"
  # Credentials come from the standard AWS chain (environment,
  # ~/.aws/credentials, SSO); set aws.profile in the config to pin a
  # named profile.
  {%- if aws.profile is defined %}
  profile = "{{ aws.profile }}"
  {%- endif %}
}

resource "aws_vpc" "vpc" {
  cidr_block = "{{ aws.vpc_cidr | default('10.10.0.0/16') }}"
  tags       = { Name = "{{ network.name }}" }
}

resource "aws_internet_gateway" "igw" {
  vpc_id = aws_vpc.vpc.id
  tags   = { Name = "{{ network.name }}" }
}

resource "aws_route_table" "rt" {
  vpc_id = aws_vpc.vpc.id

  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.igw.id
  }

  tags = { Name = "{{ network.name }}" }
}

# One subnet per NIC; with the default VPC CIDR these come out as
# 10.10.<i>.0/24, the same layout the GCP multi-NIC setup uses.
resource "aws_subnet" "subnet" {
  count                   = {{ vm.nic_count }}
  vpc_id                  = aws_vpc.vpc.id
  cidr_block              = cidrsubnet(aws_vpc.vpc.cidr_block, 8, count.index)
  availability_zone       = "{{ aws.availability_zone }}"
  map_public_ip_on_launch = true
  tags                    = { Name = "{{ network.name }}-subnet-${count.index}" }
}

resource "aws_route_table_association" "subnet" {
  count          = {{ vm.nic_count }}
  subnet_id      = aws_subnet.subnet[count.index].id
  route_table_id = aws_route_table.rt.id
}

# Stateful default-deny allow-list: the analog of the GCP firewall rules.
# Inbound is SSH from network.ssh_source_ranges plus any
# network.open_ports; everything else is denied. The group attaches to
# every ENI, so one policy covers every NIC and every address.
resource "aws_security_group" "vm" {
  name   = "{{ network.name }}-vm"
  vpc_id = aws_vpc.vpc.id

  ingress {
    description = "SSH from network.ssh_source_ranges"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [{% for cidr in network.ssh_source_ranges %}"{{ cidr }}"{{ ", " if not loop.last }}{% endfor %}]
  }
{% for rule in open_port_rules %}
  ingress {
    description = "network.open_ports"
    from_port   = {{ rule["from"] }}
    to_port     = {{ rule["to"] }}
    protocol    = "{{ rule["proto"] }}"
    cidr_blocks = ["0.0.0.0/0"]
  }
{% endfor %}
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Name = "{{ network.name }}-vm" }
}
{% if vm.image.ssm_parameter is defined %}
# The OS publisher exposes its latest AMI ID as a public SSM parameter;
# it resolves at apply time, like a GCP image family.
data "aws_ssm_parameter" "ami" {
  name = "{{ vm.image.ssm_parameter }}"
}
{% elif vm.image.ami_owner is defined %}
# Marketplace/community AMI: the newest match from the vendor's account.
data "aws_ami" "ami" {
  most_recent = true
  owners      = ["{{ vm.image.ami_owner }}"]

  filter {
    name   = "name"
    values = ["{{ vm.image.ami_name_filter }}"]
  }

  filter {
    name   = "state"
    values = ["available"]
  }
}
{% endif %}
resource "aws_instance" "vm" {
  ami           = {{ ami_expression }}
  instance_type = "{{ vm.machine_type }}"

  root_block_device {
    volume_size = {{ vm.boot_disk_gb }}
    volume_type = "{{ vm.boot_disk_type }}"
  }
{% if vm.nic_count == 1 and vm.external_ip_count == 1 %}
  subnet_id              = aws_subnet.subnet[0].id
  vpc_security_group_ids = [aws_security_group.vm.id]
{% else %}
{%- for i in range(vm.nic_count) %}
  network_interface {
    network_interface_id = aws_network_interface.nic[{{ i }}].id
    device_index         = {{ i }}
  }
{% endfor %}
{%- endif %}
  # The merged base-login keys ride in user_data; AWS has no equivalent
  # of GCP's ssh-keys metadata, so changing keys REPLACES the instance.
  user_data                   = <<-EOT
{{ user_data | indent(2, true, true) }}
  EOT
  user_data_replace_on_change = true

  tags = { Name = "{{ vm.name }}" }
}
{% if vm.nic_count > 1 or vm.external_ip_count > 1 %}
# Explicit network interfaces. The primary ENI carries
# vm.external_ip_count private addresses (its own plus one secondary per
# extra external address); the guest configures the secondaries via the
# policy-routing unit in user_data. Every public address is an Elastic
# IP: attaching pre-created ENIs disables the subnet's auto-assign, so
# even the primary's base address needs one.
resource "aws_network_interface" "nic" {
  count           = {{ vm.nic_count }}
  subnet_id       = aws_subnet.subnet[count.index].id
  security_groups = [aws_security_group.vm.id]
{% if vm.external_ip_count > 1 %}
  # The primary ENI carries one secondary private IP per extra external
  # address. They are auto-assigned (fixing specific addresses would
  # fight the ENI's immutable primary IP); the EIP associations below
  # pick them up via the private_ip_list attribute.
  private_ips_count = count.index == 0 ? {{ vm.external_ip_count - 1 }} : null
{% endif %}
  tags = { Name = "{{ vm.name }}-nic-${count.index}" }
}

# One Elastic IP per external address on the primary ENI.
resource "aws_eip" "primary" {
  count      = {{ vm.external_ip_count }}
  domain     = "vpc"
  depends_on = [aws_internet_gateway.igw]
  tags       = { Name = "{{ vm.name }}-eip-${count.index + 1}" }
}

resource "aws_eip_association" "primary" {
  count                = {{ vm.external_ip_count }}
  allocation_id        = aws_eip.primary[count.index].id
  network_interface_id = aws_network_interface.nic[0].id
  private_ip_address   = aws_network_interface.nic[0].private_ip_list[count.index]
}
{% if vm.nic_count > 1 %}
# Secondary ENIs get no public IP automatically; one Elastic IP each.
resource "aws_eip" "secondary" {
  count      = {{ vm.nic_count - 1 }}
  domain     = "vpc"
  depends_on = [aws_internet_gateway.igw]
  tags       = { Name = "{{ vm.name }}-nic${count.index + 1}-eip" }
}

resource "aws_eip_association" "secondary" {
  count                = {{ vm.nic_count - 1 }}
  allocation_id        = aws_eip.secondary[count.index].id
  network_interface_id = aws_network_interface.nic[count.index + 1].id
}
{% endif %}
{%- endif %}
output "public_ip" {
  value = {{ public_ip_expr }}
}

output "public_ips" {
  value = {{ public_ips_expr }}
}

output "ssh_command" {
  value = {{ ssh_command_expr }}
}
